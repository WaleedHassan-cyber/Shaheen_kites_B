PORT=5000
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Local testing. For the live site paste your MongoDB Atlas connection string here instead.
MONGO_URI=mongodb://127.0.0.1:27017/kite_invoices

# ---- Login security (already generated for you, keep it secret) ----
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING

# ---- Cloudinary (cloudinary.com > Dashboard > API Keys) ----
CLOUDINARY_CLOUD_NAME=PASTE_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=PASTE_YOUR_API_KEY
CLOUDINARY_API_SECRET=PASTE_YOUR_API_SECRET

# ---- Invoice number prefix: SLK-0001 ----
INVOICE_PREFIX=SLK

# ---- Owner account (used ONLY by 'npm run seed' on your own computer) ----
ADMIN_NAME=Owner
ADMIN_USERNAME=owner
ADMIN_PASSWORD=ChangeMe123
